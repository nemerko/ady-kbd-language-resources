  "title": "Adyghe (ady) Cyrillic ↔ Turkish (tr) Latin Transliteration Table",
  "description": "A grapheme-and-phoneme oriented mapping between the Adyghe Cyrillic alphabet and Turkish Latin letters, designed so that the conversion can also be reversed.",
  "version": "1.0.0",
  "updated": "2026-08-14",
  "status": "stable",
  "source": "ady-Cyrl",
  "target": "tr-Latn",
  "transform": "tr-Latn-t-ady-Cyrl",
  "reverse_transform": "ady-Cyrl-t-tr-Latn",
  "transform_standard": "BCP 47 Extension T (RFC 6497)",
  "documentation": "./ady-Cyrl-tr-Latn-transliteration.md",
  "license": "CC-BY-4.0",
  "license_url": "https://creativecommons.org/licenses/by/4.0/",
  "authors": [
    {
      "name": "M. Uğur Nemlioğlu",
      "orcid": "0000-0002-1969-2356"
    }
  ],
  "cite_as": "Nemlioğlu, M. U. (2026). Adyghe (ady) Cyrillic ↔ Turkish (tr) Latin Transliteration Table (Version 1.0.0) [Data set]. ady-kbd-language-resources. https://github.com/nemerko/ady-kbd-language-resources",
  "unicode_normalisation": "NFC",
  "characters_of_note": {
    "palochka_upper": "Ӏ",
    "palochka_lower": "ӏ",
    "note": "U+04C0 and U+04CF. Never the Latin capital I (U+0049), the Latin small l (U+006C) or the digit 1 (U+0031)."
  },
  "rules": {
    "order": "Sort by the length of the source string, longest first, in whichever direction you are converting. The arrays below are in alphabetical order and must not be applied in that order.",
    "drop_if_unmatched": [
      "ъ",
      "ь"
    ],
    "context_dependent": "Entries listed in \"context_dependent\" take the given form at the start of a word and the form in \"main\" everywhere else.",
    "all_caps": "The upper-case columns are recorded for reference; the conversion has not been exercised on all-caps text.",
    "auxiliary": "\"auxiliary\" letters are not part of the official alphabet and are kept out of \"main\". Include them only when the material contains the dialect they belong to."
  },
